# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only: Supabase service role key (bypasses RLS - keep secret, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Bolt Fleet API (v2). In production every fleet connects its OWN key at
# /fleet/bolt (stored encrypted in the database) — these two are only a handy
# place to keep a key for local testing; the app does not read them.
BOLT_CLIENT_ID=your_bolt_client_id
BOLT_CLIENT_SECRET=your_bolt_client_secret

# Optional: key used to encrypt third-party credentials (e.g. Bolt API secrets)
# before they are stored. Any long random string. When unset, a key derived
# from SUPABASE_SERVICE_ROLE_KEY is used. Changing it means fleets reconnect.
INTEGRATIONS_SECRET_KEY=

# Uber API
UBER_APP_ID=your_uber_app_id
UBER_SECRET=your_uber_secret
UBER_API_BASE_URL=https://api.uber.com/v1

# App URL (for email links). Production: https://rovora.eu
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Rovora

# "Sign in with Google" (login page). OAuth Web client ID from Google Cloud →
# Google Auth Platform → Clients. Public by design. Leave empty to hide the button.
# The same ID (+ its secret) goes in Supabase → Authentication → Providers → Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Push Notifications (Web Push VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=admin@yourdomain.com

# Email Notifications (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Rovora <noreply@rovora.eu>
# Optional: key for signing unsubscribe links in campaign emails (admin →
# Email campaigns). Any long random string. When unset, one is derived from
# INTEGRATIONS_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY. Changing it breaks the
# unsubscribe links in emails already sent.
EMAIL_UNSUBSCRIBE_SECRET=

# Stripe Billing
# Secret key from https://dashboard.stripe.com/test/apikeys (use the TEST key while developing)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret. Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints whsec_...  Production: copy it from the webhook endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Landing-page support chatbot (OpenAI / ChatGPT)
# Key from https://platform.openai.com/api-keys (account needs billing/credit).
# Without it, the chat widget gracefully falls back to "Talk to a real person".
OPENAI_API_KEY=sk-xxx
# Optional model override (defaults to gpt-4o-mini)
# SUPPORT_CHAT_MODEL=gpt-4o
